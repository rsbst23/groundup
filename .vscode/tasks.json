{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/samples/GroundUp.Sample/GroundUp.Sample.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Quick when nothing changed; installs on the first run and after package.json changes.
            "label": "web: npm install",
            "type": "shell",
            "command": "npm install --no-audit --no-fund",
            "options": {
                "cwd": "${workspaceFolder}/samples/GroundUp.Sample.Web"
            },
            "problemMatcher": []
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/samples/GroundUp.Sample/GroundUp.Sample.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/samples/GroundUp.Sample/GroundUp.Sample.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}